# Copy to .env.local and fill in.
# Resend API key powers the Get Involved contact form (/api/contact).
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY=

# The address the site sends from. It must be on a domain verified in Resend.
# Defaults to "UTDSYS Website <website@utdsys.com>" when unset.
RESEND_FROM=

# A Discord channel webhook (Channel settings > Integrations > Webhooks).
# Each form message is also posted there for the execs. Keep it secret:
# anyone with the URL can post to the channel.
DISCORD_WEBHOOK_URL=
